{
  "name": "@sinclair/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "이벤트 스키마, Run/Attempt 상태, 엔진 계약, 디바이스 JSON-RPC 타입. ./testing 서브패스(계약 스위트)는 vitest 가 있을 때만 쓴다",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/fake-engine": "./src/testing/fake-engine.ts",
    "./testing/login-scenario": "./src/testing/login-scenario.ts"
  },
  "peerDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
